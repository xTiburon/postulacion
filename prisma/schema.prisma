generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Estado {
  REVISAR
  APROBADO
  RECHAZADO
}

enum AccionRegistro {
  APROBADA
  RECHAZADA
  ELIMINADA
}

model Postulacion {
  id               String   @id @default(cuid())
  email            String   @unique
  minecraftUsuario String
  discordUsuario   String
  edad             Int
  estado           Estado   @default(REVISAR)

  // Respuestas del cuestionario (pregunta -> respuesta). Se guardan como
  // JSON para poder ajustar las preguntas del formulario sin migraciones.
  respuestas       Json

  notasAdmin       String?  @db.Text

  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  @@index([estado])
  @@index([creadoEn])
}

// Historial de quién aprobó, rechazó o eliminó cada postulación. Guarda una
// copia de los datos del postulante para que el registro siga teniendo
// sentido aunque la postulación original se elimine después.
model RegistroAdmin {
  id                  String         @id @default(cuid())
  accion              AccionRegistro
  adminNombre         String
  adminDiscordId      String
  postulacionId       String?
  postulanteMinecraft String
  postulanteEmail     String
  creadoEn            DateTime       @default(now())

  @@index([creadoEn])
}
