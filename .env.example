# Base de datos PostgreSQL (Neon, gratis) — ver DEPLOY.md paso 1
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"
DIRECT_URL="postgresql://usuario:password@host/db?sslmode=require"

# Auth.js — genera uno con: npx auth secret
AUTH_SECRET="reemplazar-con-un-valor-aleatorio-largo"

# App de Discord (Discord Developer Portal) — ver DEPLOY.md paso 2
AUTH_DISCORD_ID="tu-client-id"
AUTH_DISCORD_SECRET="tu-client-secret"

# Acceso al panel admin por rol de Discord (recomendado): cualquiera con
# uno de estos roles, dentro de este servidor, puede entrar al panel.
ADMIN_DISCORD_GUILD_ID="id-de-tu-servidor-de-discord"
ADMIN_DISCORD_ROLE_IDS="id-del-rol-de-staff,id-de-otro-rol"

# (Opcional) acceso también por ID de usuario específico, sin depender del rol
ADMIN_DISCORD_IDS="123456789012345678,987654321098765432"
